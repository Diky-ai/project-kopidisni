# Contoh variabel environment untuk Supabase.
# File ini hanya berisi NAMA variabelnya, tanpa nilai asli.
# Salin file ini menjadi `.env.local` dan isi nilai aslinya di sana.
# `.env.local` tidak boleh di-commit ke Git (sudah ada di .gitignore).
#
# Variabel di bawah ini BELUM dipakai oleh starter ini.
# Supabase baru dipakai saat fase penyimpanan project tiba.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
